# BenchOS API (server-side BFF target — never exposed to the browser)
BACKEND_API_URL=http://localhost:8080

# Public tracking base URL used when rendering QR codes and receipt links
PUBLIC_TRACKING_BASE_URL=http://localhost:8080/track
NEXT_PUBLIC_TRACKING_BASE_URL=http://localhost:8080/track

# Secret used by the BFF to encrypt the HttpOnly session cookie (AES-256-GCM).
# In production, generate a CSPRNG 32+ byte secret (e.g. `openssl rand -base64 48`).
SESSION_SECRET=benchos-local-dev-session-secret-change-in-production-32bytes!

NEXT_PUBLIC_APP_NAME=BenchOS

# Marketing site & multi-host routing (optional — defaults shown below)
# NEXT_PUBLIC_SITE_URL=https://benchos.app.br
# NEXT_PUBLIC_APP_URL=https://app.benchos.app.br
# NEXT_PUBLIC_MARKETING_HOSTS=benchos.app.br,www.benchos.app.br
# NEXT_PUBLIC_SUPPORT_EMAIL=contato@benchos.app.br
# NEXT_PUBLIC_SUPPORT_WHATSAPP=5511999999999
